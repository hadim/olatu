# Olatu — local environment. Copy to `.env` (gitignored) and fill in.
# Every key here is INGEST-ONLY: the static webapp never sees them (they'd be public).
# In CI these are provided as GitHub Actions secrets, not from this file.

# --- Tides: api-maree.fr (spec 0008) ---
# Water-level predictions behind the marée feature. Free key at https://api-maree.fr.
# Missing → the tide step skips and the webapp shows the tide empty-state.
API_MAREE_KEY=

# --- Wind: Météo-France (spec 0012) ---
# Real-time 6-minute station observations via the "Données d'observation" (DPObs) API
# on https://portail-api.meteofrance.fr — create a free account, subscribe to that API
# (100 req/min). This key is only needed for the LIVE 6-minute layer.
# The historical HOURLY wind needs NO key: it comes from the open bulk files on
# https://meteo.data.gouv.fr (Licence Ouverte). Missing key → the 6-min step skips,
# the hourly history still builds.
METEOFRANCE_API_KEY=

# --- Optional ---
# HF bucket token. Local runs use your cached `hf` login, so normally leave this blank.
# HF_TOKEN=
# Upper bound (seconds) on any single ingest network step; 0 disables the watchdog.
# OLATU_NET_TIMEOUT=600
# Webapp only: override the data base URL (defaults to the public HF bucket).
# VITE_DATA_BASE_URL=
